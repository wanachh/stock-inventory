{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "🚀 Full Stack: Backend + Frontend (F5)",
      "configurations": [
        "Backend (.NET 10 API)",
        "Frontend (Next.js Web)"
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Backend (.NET 10 API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/bin/Debug/net10.0/StockInventory.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend",
      "stopAtEntry": false,
      "launchBrowser": {
        "enabled": false
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Frontend (Next.js Web)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "npm run dev",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s*(https?://\\S+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "Frontend (Google Chrome - หากลง Chrome ไว้)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ]
}
